# Copy to .env.capstone (gitignored) and fill in, then: node scripts/push-to-n8n.mjs

# Your n8n cloud workspace + API key (n8n → Settings → n8n API → Create an API key)
N8N_HOST=https://northwestern-mmm.app.n8n.cloud
N8N_API_KEY=

# REQUIRED: short unique suffix for YOUR webhook paths in the shared workspace
# (initials or netid, lowercase, no spaces — e.g. mk or mknoedel)
CAPSTONE_SUFFIX=

# Leave blank to auto-generate a strong webhook secret (printed at the end)
WEBHOOK_SECRET=

# --- Reuse credentials that ALREADY exist in n8n (preferred — no secrets
# --- needed here). Open the credential in the n8n UI and copy the id from the
# --- browser URL (.../credentials/<id>). If an *_CREDENTIAL_ID is set, the
# --- matching secret below is ignored.
OPENROUTER_CREDENTIAL_ID=
SUPABASE_CREDENTIAL_ID=
POSTGRES_CREDENTIAL_ID=
ZEP_CREDENTIAL_ID=
WEBHOOK_AUTH_CREDENTIAL_ID=

# OpenRouter (the key from class) — only needed if no OPENROUTER_CREDENTIAL_ID
OPENROUTER_API_KEY=

# Zep Cloud (app.getzep.com → Project Settings → API Keys)
ZEP_API_KEY=

# Supabase — SESSION POOLER connection (Supabase → Connect → Session pooler).
# Used by the Postgres Chat Memory nodes, which open a RAW database connection:
# the password is your project's DATABASE password (Project Settings → Database
# → reset it if unknown) — the service role key does NOT work here.
# host looks like aws-0-us-east-2.pooler.supabase.com, user like postgres.abcdefghij
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Supabase API (project URL + service_role key, Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
